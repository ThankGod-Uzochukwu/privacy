<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Veil is deliberately NOT sandboxed: blocking capture shortcuts needs a CGEventTap,
		which the App Sandbox forbids. Distribute outside the Mac App Store (Developer ID +
		notarization). Users grant the Accessibility permission on first use.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
